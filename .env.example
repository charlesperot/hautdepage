# --- beehiiv (obligatoire pour le formulaire d'inscription) ---
# Clé API beehiiv. NE JAMAIS exposer côté client — server-only.
# Settings > API dans ton compte beehiiv.
BEEHIIV_API_KEY=

# ID de la publication beehiiv (format: pub_xxxxxxxx-xxxx-...).
BEEHIIV_PUBLICATION_ID=

# --- Archive (optionnel) ---
# URL publique de l'archive beehiiv. Si vide/absente, la section
# "Dernières éditions" est masquée automatiquement.
NEXT_PUBLIC_ARCHIVE_URL=
